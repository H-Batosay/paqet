# paqet Server Configuration
# Minimal required config — network settings are auto-detected.
role: "server"

# ── Required ────────────────────────────────────────────────────
listen:
  addr: ":9999"                   # CHANGE ME: listen port
                                  # WARNING: avoid ports 80/443 (iptables side effects)

transport:
  protocol: "kcp"
  kcp:
    key: "your-secret-key-here"   # CHANGE ME: must match client key

# ── Optional: override auto-detected network settings ───────────
# network:
#   interface: "eth0"             # Auto-detected from routing table
#   ipv4:
#     addr: "10.0.0.100:9999"    # Auto-detected; port must match listen.addr
#     router_mac: "aa:bb:cc:dd:ee:ff"  # Auto-detected via ARP
#   tcp:
#     local_flag: ["PA"]          # TCP flags for server → client packets

# ── Optional: logging ───────────────────────────────────────────
# log:
#   level: "info"                 # none, debug, info, warn, error, fatal

# ── Optional: KCP tuning ────────────────────────────────────────
# transport:
#   kcp:
#     mode: "auto"                # auto (default), normal, fast, fast2, fast3, turbo, manual
#     # block: "aes"
#     # mtu: 1350
#     # rcvwnd: 1024
#     # sndwnd: 1024

# ══════════════════════════════════════════════════════════════════
# REQUIRED: Server firewall setup (run once as root)
# See scripts/server-init.sh  or run:
#   sudo scripts/server-init.sh 9999
# ══════════════════════════════════════════════════════════════════
