# paqet Client Configuration
# Minimal required config — network settings are auto-detected.
role: "client"

# ── Required ────────────────────────────────────────────────────
server:
  addr: "SERVER_IP:9999"          # CHANGE ME: paqet server address and port

transport:
  protocol: "kcp"
  kcp:
    key: "your-secret-key-here"   # CHANGE ME: must match server key

# ── Choose at least one proxy or forwarder ──────────────────────

# SOCKS5 proxy — point any app here to tunnel all its traffic
socks5:
  - listen: "127.0.0.1:1080"     # SOCKS5 proxy listen address
  # username: "user"             # Optional auth
  # password: "pass"

# Port forwarding — bind a local port and pipe it straight to a
# fixed remote target through the paqet tunnel.
# Multiple entries are allowed; mix TCP and UDP freely.
#
# forward:
#   # TCP example: SSH to the server's own port 22
#   - listen:   "127.0.0.1:2222"
#     target:   "127.0.0.1:22"     # address as seen FROM the server
#     protocol: "tcp"
#
#   # TCP example: reach a DB on a host behind the server
#   - listen:   "127.0.0.1:5432"
#     target:   "10.0.0.50:5432"
#     protocol: "tcp"
#
#   # UDP example: DNS via the server's resolver
#   - listen:   "127.0.0.1:5353"
#     target:   "8.8.8.8:53"
#     protocol: "udp"

# ── Optional: override auto-detected network settings ───────────
# network:
#   interface: "eth0"             # Auto-detected from routing table
#   # guid: "\Device\NPF_{...}"  # Windows only — auto-detected from Npcap
#   ipv4:
#     addr: "192.168.1.100:0"    # Auto-detected; :0 = random port
#     router_mac: "aa:bb:cc:dd:ee:ff"  # Auto-detected via ARP
#   tcp:
#     local_flag:  ["PA"]        # Run: paqet probe -c config.yaml  to find best flags
#     remote_flag: ["PA"]

# ── Optional: logging ───────────────────────────────────────────
# log:
#   level: "info"                 # none, debug, info, warn, error, fatal

# ── Optional: KCP tuning ────────────────────────────────────────
# transport:
#   conn: 1                       # Number of parallel connections
#   kcp:
#     mode: "auto"                # auto (default), normal, fast, fast2, fast3, turbo, manual
#     # block: "aes"              # Encryption: aes, aes-128, salsa20, xor, none, null
#     # mtu: 1350
#     # rcvwnd: 512
#     # sndwnd: 512
#     # smuxkalive: 10            # Keep-alive interval (seconds)
#     # smuxktimeout: 30          # Keep-alive timeout (seconds)
